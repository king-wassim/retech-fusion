# Copy this file to `.env` and fill in your values

# Paths
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed

# CO2 emission factor (kg CO2 per kWh) — Tunisia grid average
CO2_FACTOR_KG_PER_KWH=0.468

# MQTT (IoT) — optional
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=retech/energy/+

# OCR
TESSERACT_CMD=/usr/bin/tesseract

# Gemini API (optional — enables high-quality OCR on images and scanned PDFs)
GEMINI_API_KEY=AIzaSyCJE9s95fQM5DGgtvv1gxzumGiHCCfmZ9w
GEMINI_MODEL=gemini-2.0-flash
